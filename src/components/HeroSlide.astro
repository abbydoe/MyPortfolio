---
import Headshot from "../assets/Headshot.png";
import arrow from "../assets/material-down.svg";
---

<div class="swiper-slide">
  <div class="text">
    <div class="herotext">
      <h1 class="hero-h1">
        Hi, I'm Abby, a mobile UX Designer forced to become a full-stack
        devloper
      </h1>
      <button id="caseButton" class="hero-button">Recent Work</button>
      <img src={arrow.src} alt="navigation arrow down" class="arrow" />
    </div>
  </div>
</div>

<script>
  document.getElementById("caseButton")?.addEventListener("click", () => {
    console.log("Button clicked");
    const event = new CustomEvent("scroll-to-section", {
      bubbles: true,
    });
    dispatchEvent(event);
  });
</script>

<style>
  .arrow {
    display: none;
  }
  .grouped {
    border-left: 1px solid #1e293b;
    padding-left: 8px;
  }
  .herotext {
    padding-top: 10rem;
    padding-bottom: 10rem;
  }

  /* Mobile layout */
  @media (max-width: 768px) {
    .arrow {
      display: block;
      width: 24px; /* or whatever size fits */
      height: auto;
    }

    .content {
      flex-direction: column;
      text-align: center;
      align-items: center;
      padding-top: 4rem;
      justify-content: flex-start !important;
    }

    .content img {
      z-index: 99999;
    }

    .text {
      max-width: 90%;
    }

    h1 {
      font-size: 40px;
      padding-bottom: 0px;
      width: 100%;
    }

    .grouped {
      margin: 0;
      font-size: 20px;
      border-left: 1px solid rgb(199, 199, 199);
      padding-left: 8px;
      width: 90%;
    }
    .text {
      width: 90%;
      display: flex;
      flex-direction: column;
      align-items: center; /* ✅ center everything horizontally */
    }
    .herotext {
      margin-top: 10rem;
      margin-bottom: 10rem;
    }
    .text button {
      margin: 120px 0 0 0;
      border: none;
      font-size: 20px;
      color: #1e293b;
      background-color: #f8fafc;
    }
  }
</style>
