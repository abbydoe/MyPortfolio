---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroSlide from "../components/HeroSlide.astro";
import CaseStudySlide from "../components/CaseStudySlide.astro";
import { Image } from "astro:assets";
import arrow from "../assets/material-down.svg";
const caseStudies = [
    {
    title: "Skate Match",
    subtitle: "Mobile App",
    video: "/assets/skatedemo.mp4",
    tags: [
      { label: "UX Design", class: "first" },
      { label: "Full-stack Development", class: "second" },
    ],
    description:
      "A way for figure skaters to find ice dancing or pair skating partners.",
    link: "/skate",
  },
{
    title: "Font Theme",
    subtitle: "Figma Plugin",
    video: "/assets/PluginDemo.mov",
    tags: [
      { label: "UI Design", class: "first" },
      { label: "Front-end Development", class: "second" },
    ],
    description:
      "Get font inspiration, find theme-based pairs, and save them as reusable text styles in one click.",
    link: "/plugin",
  },
  {
    title: "Marcy K Salon",
    subtitle: "Salon Service and Booking Site",
    image: "/assets/Marcy.png",
    tags: [
      { label: "UX Research", class: "first" },
      { label: "Responsive UI Design", class: "second" },
    ],
    description:
      "Integrated Calendly to reduce no-shows, streamline booking and service flow, and led user research.",
    link: "/salon",
  },
  {
    title: "Ice Time",
    subtitle: "Native Mobile App",
    image: "/assets/IceTime.png",
    tags: [{ label: "UI Design", class: "first" }],
    description:
      "Locate rinks with freestyle sessions when traveling. Sign waivers, pay, and reserve ice time.",
    link: "/ice",
  },
];
---

<Layout>
  <Header />
  <section class="casestudies">
    <div class="swiper">
      <div class="swiper-wrapper">
        <HeroSlide />
        {caseStudies.map((item) => <CaseStudySlide {...item} />)}
      </div>
      <button
        class="mobile-slide-arrow"
        id="mobileSlideArrow"
        aria-label="Next slide"
      >
      <img src={arrow.src} alt="navigation arrow down" class="arrow" />
      </button>
      <div class="swiper-pagination"></div>
    </div>
  </section>
</Layout>

<style>
  .text{
    padding-top: 0%;
    padding bottom: 0%;
  }
   @media (max-width: 768px) {
    h1{
      margin: 1rem;
    }
</style>

<script>
  const script = document.createElement("script");
  script.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";
  script.onload = () => {
    if (document.querySelector(".swiper")) {
      const swiper = new Swiper(".swiper", {
        direction: "vertical",
        loop: false,
        spaceBetween: 30,
        speed: 1000,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
          dynamicBullets: true,
        },
        on: {
          slideChange() {
            const pagination = document.querySelector(".swiper-pagination");
            const mobileArrow = document.getElementById("mobileSlideArrow");

            // ✅ Hide pagination + arrow on first slide
            if (swiper.activeIndex === 0) {
              if (pagination) pagination.style.display = "none";
              if (mobileArrow) mobileArrow.style.display = "none";
            } else {
              if (pagination) pagination.style.display = "block";
              if (mobileArrow) mobileArrow.style.display = "flex"; // or "block"
            }
            // 1. Pause all videos and reset their time
document.querySelectorAll('.auto-play-video').forEach(vid => {
    vid.pause();
    vid.currentTime = 0; // Reset video to the beginning
});

// 2. Find the video in the currently active slide and play it
const activeSlide = this.slides[this.activeIndex]; // 'this' refers to the Swiper instance
if (activeSlide) {
    const activeVideo = activeSlide.querySelector('.auto-play-video');
    if (activeVideo) {
        activeVideo.play().catch(error => {
            // Handle potential autoplay errors (e.g., if video is not muted)
            console.warn("Autoplay prevented for video:", error);
            // You might want to display a play button here for the user
        });
    }
}
          },
        },
        mousewheel: true,
        keyboard: true,
      });

      // ✅ THIS is what you were missing
      const arrowBtn = document.getElementById("mobileSlideArrow");
      if (arrowBtn) {
        arrowBtn.addEventListener("click", () => {
          swiper.slideNext();
        });
      }

      if (swiper.activeIndex === 0) {
        document.querySelector(".swiper-pagination").style.display = "none";
        document.getElementById("mobileSlideArrow").style.display = "none";
      }

      window.addEventListener("scroll-to-section", () => {
        swiper.slideTo(1);
      });

      /* const video = document.querySelector(".auto-play-video");
      if (video) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.isIntersecting ? video.play() : video.pause();
            });
          },
          { threshold: 0.5 },
        );
        observer.observe(video);
      } */

      function scrollToSection() {
        swiper.slideTo(1);
      }

      document
        .getElementById("resumeLink")
        ?.addEventListener("click", function (e) {
          e.preventDefault();
          const resumeUrl = "/assets/Abigail.Harris.Resume.pdf";
          window.open(resumeUrl, "_blank");

          const downloadLink = document.createElement("a");
          downloadLink.href = resumeUrl;
          downloadLink.download = "AbbyHarris_resume.pdf";
          document.body.appendChild(downloadLink);
          downloadLink.click();
          document.body.removeChild(downloadLink);
        });
    }
  };
  document.body.appendChild(script);
</script>
